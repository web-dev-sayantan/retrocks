{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "retrocks",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      },
      {
        "name": "POINTING_POKER_ROOM",
        "class_name": "PointingPokerRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PointingPokerRoom"]
    }
  ],
  "ratelimits": [
    {
      "name": "BOARD_CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
