{
  "name": "retrocks",
  "version": "0.0.0",
  "description": "Free, zero-login, privacy-first collaborative retrospective boards",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:node": "RETROCKS_RUNTIME=node vite",
    "build": "vite build",
    "build:node": "RETROCKS_RUNTIME=node vite build",
    "start": "node --env-file-if-exists=.env dist/server/node.js",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@solidjs/diagnostics": "^2.0.0",
    "@solidjs/start-devtools": "^1.0.0-next.4",
    "@solidjs/testing-library": "^1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^26.6.6",
    "eslint-plugin-solid": "~0.20.0",
    "filesystem-routing": "0.5.0",
    "jsdom": "^31.0.0",
    "oxlint": "~1.92.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "dependencies": {
    "@remix-run/cookie": "^1.0.2",
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.0",
    "@ui-sdk/core": "0.1.0-beta.10",
    "@ui-sdk/solid": "0.1.0-beta.10",
    "lucide": "^1.75.0",
    "solid-js": "^2.0.0",
    "uqr": "^0.1.3",
    "valibot": "^1.4.2"
  }
}
